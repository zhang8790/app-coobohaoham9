@charset "UTF-8";.consult-page{display:flex;flex-direction:column;min-height:100vh;background:linear-gradient(180deg,#fff9ef,#fffbf7 480rpx 100%)}.consult-hero{padding:56rpx 40rpx 44rpx;background:linear-gradient(135deg,#f59e0b,#d97706);border-bottom-left-radius:48rpx;border-bottom-right-radius:48rpx;box-shadow:0 16rpx 48rpx #d977062e}.consult-hero-emoji{display:block;font-size:68rpx;line-height:1;margin-bottom:12rpx}.consult-hero-title{display:block;font-size:52rpx;font-weight:800;color:#fff;letter-spacing:2rpx}.consult-hero-sub{display:block;margin-top:8rpx;font-size:26rpx;color:#ffffffe6}.consult-scroll{flex:1;padding:28rpx 28rpx 0}.consult-chips{display:flex;flex-wrap:wrap;gap:16rpx;margin-top:28rpx}.consult-chip{padding:14rpx 24rpx;border-radius:1998rpx;background:#fff;border:2rpx solid rgba(200,164,92,.35)}.consult-chip-text{font-size:26rpx;color:#9a6b1e}.consult-empty{margin-top:36rpx;padding:36rpx 32rpx;background:#fffbf2b3;border-radius:32rpx;border:2rpx dashed rgba(200,164,92,.4)}.consult-empty-text{font-size:26rpx;line-height:1.7;color:#9a8070}.consult-turn{margin-top:32rpx}.consult-bubble-user{display:flex;justify-content:flex-end;margin-bottom:16rpx}.consult-bubble-user-text{max-width:78%;padding:20rpx 28rpx;border-radius:32rpx 32rpx 8rpx;background:linear-gradient(135deg,#f59e0b,#d97706);color:#fff;font-size:28rpx;line-height:1.5}.consult-bubble-bot{margin-bottom:20rpx}.consult-bubble-bot-text{display:block;padding:20rpx 28rpx;border-radius:32rpx 32rpx 32rpx 8rpx;background:#fff;border:2rpx solid rgba(200,164,92,.25);color:#4a3b2c;font-size:26rpx;line-height:1.6}.consult-rec-card{display:flex;gap:20rpx;padding:24rpx;margin-bottom:20rpx;background:#fff;border-radius:36rpx;border:2rpx solid rgba(200,164,92,.22);box-shadow:0 8rpx 28rpx #78350f0d}.rec-img{width:168rpx;height:168rpx;border-radius:28rpx;background:#f3ede4;flex-shrink:0}.rec-body{flex:1;min-width:0}.rec-title-row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.rec-name{flex:1;font-size:30rpx;font-weight:700;color:#2a2118}.rec-meta{display:flex;align-items:center;flex-wrap:wrap;gap:12rpx;margin-top:12rpx}.rec-price{font-size:30rpx;font-weight:700;color:#d97706}.rec-nature{font-size:22rpx;color:#6b5847;background:#f3ede4;padding:2rpx 14rpx;border-radius:12rpx}.rec-tag{font-size:22rpx;color:#9a6b1e;background:#fff4e2;padding:2rpx 14rpx;border-radius:12rpx}.rec-reasons{margin-top:16rpx;display:flex;flex-direction:column;gap:4rpx}.rec-reason{font-size:24rpx;line-height:1.5;color:#6b5847}.rec-actions{display:flex;gap:16rpx;margin-top:20rpx}.rec-btn-cart{flex:1;display:flex;align-items:center;justify-content:center;padding:18rpx 0;border-radius:24rpx;background:linear-gradient(135deg,#f59e0b,#d97706)}.rec-btn-cart-text{font-size:26rpx;font-weight:700;color:#fff}.rec-btn-detail{display:flex;align-items:center;justify-content:center;padding:18rpx 32rpx;border-radius:24rpx;background:#fff;border:2rpx solid rgba(200,164,92,.4)}.rec-btn-detail-text{font-size:26rpx;font-weight:600;color:#9a6b1e}.consult-input-bar{display:flex;align-items:flex-end;gap:16rpx;padding:20rpx 24rpx calc(20rpx + env(safe-area-inset-bottom));background:#fff;border-top:2rpx solid rgba(200,164,92,.2);box-shadow:0 -8rpx 32rpx #78350f0d}.consult-input{flex:1;min-height:80rpx;max-height:192rpx;padding:18rpx 24rpx;border-radius:28rpx;background:#f7f2ea;font-size:28rpx;color:#2a2118;line-height:1.4}.consult-input-ph{color:#b6a48f}.consult-send{display:flex;align-items:center;justify-content:center;width:120rpx;height:80rpx;border-radius:28rpx;background:linear-gradient(135deg,#f59e0b,#d97706);flex-shrink:0}.consult-send.is-loading{opacity:.7}.consult-send-text,.consult-send-loading{font-size:30rpx;font-weight:700;color:#fff}
