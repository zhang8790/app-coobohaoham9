@charset "UTF-8";@keyframes rankIn{0%{opacity:0;transform:translateY(32rpx)}to{opacity:1;transform:translateY(0)}}.rank-row-in{animation:rankIn .55s cubic-bezier(.16,1,.3,1) both}@keyframes rankFlow{0%,to{box-shadow:0 8rpx 32rpx var(--rc)}50%{box-shadow:0 16rpx 60rpx var(--rc)}}@keyframes rankSweep{0%{background-position:0% 0}to{background-position:200% 0}}.rank-current{position:relative;border-color:var(--rc)!important;animation:rankFlow 2.6s ease-in-out infinite}.rank-current:before{content:"";position:absolute;top:0;left:0;right:0;height:6rpx;background:linear-gradient(90deg,transparent 0%,var(--rc) 50%,transparent 100%);background-size:200% 100%;animation:rankSweep 2.2s linear infinite}.rank-current-pill{font-size:20rpx;font-weight:700;color:#fff;padding:4rpx 16rpx;border-radius:200rpx;background:var(--rc);margin-left:12rpx;white-space:nowrap}
